# ==========================================================
# EMILIO SAVIO — Ortam Değişkenleri Örneği
# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldurun.
# `.env.local` git'e COMMIT EDİLMEZ (gitignore'da).
# ==========================================================

# --- Supabase (emilio projesi) ---
NEXT_PUBLIC_SUPABASE_URL=https://zhonnaajslctnvjhhlgc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Sunucu tarafı admin işlemleri için (opsiyonel, gizli tutun):
SUPABASE_SERVICE_ROLE_KEY=

# --- Uygulama ---
# Üretimde gerçek domain: https://emiliosavio.com veya *.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Atlas Cloud AI (görsel/video üretimi) ---
ATLAS_API_KEY=apikey-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ATLAS_BASE_URL=https://api.atlascloud.ai/v1
ATLAS_IMAGE_MODEL=google/nano-banana-2/text-to-image

# --- PayTR (sandbox/production) ---
NEXT_PUBLIC_PAYTR_MERCHANT_ID=
NEXT_PUBLIC_PAYTR_MERCHANT_KEY=

# --- iyzico (sandbox/production) ---
NEXT_PUBLIC_IYZICO_API_KEY=
NEXT_PUBLIC_IYZICO_SECRET_KEY=
